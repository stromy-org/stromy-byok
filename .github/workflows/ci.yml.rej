diff a/.github/workflows/ci.yml b/.github/workflows/ci.yml	(rejected hunks)
@@ -7,21 +33,38 @@ on:
     branches: [main]
 
 jobs:
-  python-ci:
-    # ci-dedup (inside the reusable workflow) reads the merged PR behind a push
-    # and that PR's workflow runs. The org default token grants contents+packages
-    # only, so without these the action 403s on every push and silently never
-    # skips — the checks then run twice per change, which is the cost it exists to
-    # remove. A called workflow inherits this job's grant and can only downgrade
-    # it, so it has to be declared here rather than in ci-python.yml.
-    permissions:
-      contents: read
-      packages: read
-      pull-requests: read
-      actions: read
-    uses: stromy-org/stromy-org/.github/workflows/ci-python.yml@main
-    with:
-      source_package: "src/stromy_byok"
-    # Forward the org stromy-ci App secrets (CI_APP_ID / CI_APP_PRIVATE_KEY)
-    # so the reusable workflow can clone private deps. No-op if absent.
-    secrets: inherit
+  quality:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+      - uses: astral-sh/setup-uv@v5
+        with:
+          version: "latest"
+      - run: uv python install 3.11
+      # `--all-extras` installs [azure], so pyright type-checks the Key Vault
+      # backend instead of skipping it as an unresolved import — that backend is
+      # the one this package cannot afford to leave unchecked. Unlike
+      # asset-transport, this repo's `dev` group does NOT pull the extra in, so
+      # the flag is what makes the difference.
+      #
+      # `--locked` is load-bearing, not tidiness: a bare `uv sync` SILENTLY
+      # RELOCKS when pyproject.toml and uv.lock disagree, so CI goes green
+      # against a lockfile it regenerated and threw away, and the committed one
+      # is never asserted. Both flags mirror the shared ci-python.yml.
+      - run: uv sync --locked --all-extras
+      - name: Lint
+        run: uv run ruff check
+      - name: Type check
+        run: uv run pyright src/stromy_byok
+
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+      - uses: astral-sh/setup-uv@v5
+        with:
+          version: "latest"
+      - run: uv python install 3.11
+      - run: uv sync --locked --all-extras
+      - name: Tests
+        run: uv run pytest
